# Contact-form backend (src/app/api/contact/route.ts).
# None of these are needed to build or browse the site; without them the
# form's API route answers 500 and the UI shows its error message.

# Connection string of the linked Vercel Postgres (Neon) database. Vercel
# injects this automatically once the database is attached to the project;
# set it here only for local testing against a real database.
POSTGRES_URL=""

# Resend API key for the lead notification email to kontakt@carboncue.eu.
RESEND_API_KEY=""

# Optional sender override, e.g. "CarbonCue <noreply@carboncue.eu>" once the
# carboncue.eu domain is verified in Resend. Without it the route falls back
# to Resend's onboarding sender, which only delivers to the address that owns
# the Resend account.
CONTACT_FROM_EMAIL=""
